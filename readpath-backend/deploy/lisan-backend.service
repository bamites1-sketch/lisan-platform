[Unit]
Description=LiSAN Backend - Reading Assessment Platform
Documentation=https://github.com/bamites1-sketch/lisan-platform
After=network.target postgresql.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/lisan-backend/readpath-backend
Environment=NODE_ENV=production
EnvironmentFile=/home/ubuntu/lisan-backend/readpath-backend/.env
ExecStart=/usr/bin/node dist/server.js
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lisan-backend

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/lisan-backend

[Install]
WantedBy=multi-user.target
