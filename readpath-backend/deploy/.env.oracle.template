# Oracle Cloud Production Environment Variables
# Copy this to /home/ubuntu/lisan-backend/readpath-backend/.env

# Database (PostgreSQL on same VM)
DATABASE_URL="postgresql://lisan:YOUR_DB_PASSWORD@localhost:5432/lisan"

# Server
NODE_ENV=production
PORT=5000

# Frontend URL (your Vercel deployment)
FRONTEND_URL=https://readpath-frontend.vercel.app

# Security - Generate strong secrets
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=YOUR_JWT_SECRET_HERE
JWT_REFRESH_SECRET=YOUR_JWT_REFRESH_SECRET_HERE

# Google Gemini AI
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash-exp

# Oracle Object Storage Configuration
# Get these from Oracle Cloud Console → Object Storage → Customer Secret Keys
OCI_REGION=us-ashburn-1
OCI_NAMESPACE=YOUR_TENANCY_NAMESPACE
OCI_BUCKET_NAME=lisan-storage
OCI_ACCESS_KEY_ID=YOUR_ORACLE_ACCESS_KEY
OCI_SECRET_ACCESS_KEY=YOUR_ORACLE_SECRET_KEY

# Setup key for initial admin creation
SETUP_KEY=YOUR_SETUP_KEY_HERE
