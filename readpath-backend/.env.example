# Copy this file to .env and fill in your values

DATABASE_URL="file:./dev.db"
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Generate a long random string (e.g. openssl rand -base64 32)
JWT_SECRET="your-jwt-secret-here"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-here"

# Get a free key from https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.5-flash"

# Cloudflare R2 Configuration (see CLOUDFLARE_R2_SETUP.md for setup guide)
R2_ACCOUNT_ID=your_account_id_here
R2_ACCESS_KEY_ID=your_access_key_id_here
R2_SECRET_ACCESS_KEY=your_secret_access_key_here
R2_BUCKET_NAME=lisan-storage
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com

# One-time admin setup key (POST /api/setup/create-admin)
# Set a strong random value; leave blank to skip the check in development
SETUP_KEY=your_setup_key_here
