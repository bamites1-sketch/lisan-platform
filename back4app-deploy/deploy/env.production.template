# Production Environment Variables Template
# Copy to /var/www/readpath-backend/.env and fill in actual values

# Node Environment
NODE_ENV=production

# Server Configuration
PORT=5000

# Database (PostgreSQL)
# Format: postgresql://username:password@localhost:5432/database_name
DATABASE_URL=postgresql://readpath_user:YOUR_DB_PASSWORD@localhost:5432/readpath_db

# JWT Secrets (MUST be different and secure)
# Generate with: openssl rand -base64 64
JWT_SECRET=YOUR_JWT_SECRET_HERE
JWT_REFRESH_SECRET=YOUR_JWT_REFRESH_SECRET_HERE

# Frontend URL (for CORS)
# Add your Vercel domain
FRONTEND_URL=https://readpath-frontend.vercel.app

# Gemini AI Configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash

# Optional: Email configuration (for future notifications)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Optional: File upload configuration
# MAX_FILE_SIZE=52428800  # 50MB in bytes
# ALLOWED_FILE_TYPES=audio/webm,audio/wav,audio/mp3,application/pdf
